# alterique API — copy to .env and fill in. On Render these go in
# Settings → Environment instead.
#
# Only MONGODB_URI is needed to store submissions. Everything else adds a
# capability, and the API keeps working without it.

# --- Database (required) -------------------------------------------------
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/alterique

# --- Email notifications -------------------------------------------------
# Pick a provider and its host, port and username are filled in for you —
# usually only the API key below is left to set.
#
#   resend    SMTP_PASS = API key. Nothing else needed: it sends from
#             onboarding@resend.dev, which reaches the address the Resend
#             account was opened with. Add your own domain later and set
#             MAIL_FROM. 3,000 emails/month free.
#   brevo     SMTP_PASS = SMTP key, SMTP_USER = the login on the same page
#             (not your email), MAIL_FROM = a sender you verified. 300/day.
#   sendgrid  SMTP_PASS = API key, MAIL_FROM = a verified sender.
#   postmark  SMTP_PASS = server token (used as the username too),
#             MAIL_FROM = a verified sender.
#   mailgun   SMTP_PASS = SMTP password, SMTP_USER = postmaster@your-domain.
#   zoho / outlook / gmail  — ordinary mailboxes.
#   gmail     SMTP_PASS = a 16-character App Password, NOT the account
#             password (Google → Security → 2-Step Verification → App
#             passwords). This is the default if MAIL_PROVIDER is unset.
#
# Anything else: set MAIL_PROVIDER=smtp and give SMTP_HOST and SMTP_PORT.
MAIL_PROVIDER=resend
SMTP_PASS=re_your_api_key_here

# Only needed for providers that ask for one (see above).
# SMTP_USER=

# The sender address. Third parties only deliver from an address you have
# verified with them; resend's sandbox sender is used if you leave this blank.
# MAIL_FROM=alterique <hello@alterique.co.uk>

# Where quote requests and contact messages are sent. Defaults to
# alteriqueforuk@gmail.com, so it only needs setting to change the address.
# NOTIFY_EMAIL=alteriqueforuk@gmail.com

# Override the provider's defaults only if you must.
# SMTP_HOST=
# SMTP_PORT=

# --- Admin panel login ---------------------------------------------------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password
# Any long random string — signs the session tokens
ADMIN_TOKEN_SECRET=change-me-to-something-long-and-random

# --- Photo storage: quote photos and journal pictures (Cloudflare R2) -----
# Without these, quote photos are skipped and journal picture upload is
# turned off. See the R2 section in README.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=alterique-quotes
# The bucket's public r2.dev URL or custom domain — NOT the S3 API endpoint.
# Leave blank and photo links are signed on the fly instead.
R2_PUBLIC_URL=

# --- Misc ----------------------------------------------------------------
# Comma-separated origins allowed to call the API. Unset allows any.
# ALLOWED_ORIGIN=https://www.alterique.co.uk
# PORT=5000
